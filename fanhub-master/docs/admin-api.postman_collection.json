{
  "info": {
    "name": "Fan Hub Plus Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Session-based admin API. Run CSRF then login. Set credentials locally; see ADMIN_BACKEND.md."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/fanhub/public/admin/api"
    },
    {
      "key": "admin_email",
      "value": "admin@fanhubplus.com"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "new_user_password",
      "value": ""
    },
    {
      "key": "submission_id",
      "value": ""
    },
    {
      "key": "feedback_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication and dashboard",
      "item": [
        {
          "name": "1. Get CSRF token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set(\"csrf_token\", pm.response.json().csrf_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set(\"csrf_token\", pm.response.json().csrf_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/dashboard"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },

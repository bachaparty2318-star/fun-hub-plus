{
  "info": {
    "name": "Fan Hub Plus - Registered User API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/fanhub/public/user/api" },
    { "key": "csrf_token", "value": "" },
    { "key": "member_name", "value": "" },
    { "key": "member_email", "value": "" },
    { "key": "member_password", "value": "" },
    { "key": "new_member_email", "value": "" },
    { "key": "category_id", "value": "1" },
    { "key": "content_id", "value": "1" },
    { "key": "article_id", "value": "1" },
    { "key": "character_id", "value": "1" },
    { "key": "media_id", "value": "1" },
    { "key": "merchandise_id", "value": "1" },
    { "key": "event_id", "value": "1" },
    { "key": "bookmark_id", "value": "1" },
    { "key": "submission_id", "value": "1" },
    { "key": "feedback_id", "value": "1" },
    { "key": "verification_url", "value": "" },
    { "key": "reset_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "CSRF",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/auth/csrf" },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.csrf_token) pm.collectionVariables.set('csrf_token', json.csrf_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{member_name}}\",\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\",\n  \"password_confirmation\": \"{{member_password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.csrf_token) pm.collectionVariables.set('csrf_token', json.csrf_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.csrf_token) pm.collectionVariables.set('csrf_token', json.csrf_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Me",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/auth/me" }
        },
        {
          "name": "Resend Verification",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }], "url": "{{base_url}}/auth/email/resend" }
        },
        {
          "name": "Verify Email",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{verification_url}}" }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"{{member_password}}\",\n  \"password_confirmation\": \"{{member_password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/reset-password"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"{{member_password}}\",\n  \"password\": \"{{member_password}}\",\n  \"password_confirmation\": \"{{member_password}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/auth/password"
          }
        },
        {
          "name": "Sessions",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/auth/sessions" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }], "url": "{{base_url}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Profile and Dashboard",
      "item": [
        { "name": "Profile", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/profile" } },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{member_name}}\",\n  \"bio\": \"Fan Hub member\",\n  \"dark_mode_enabled\": true,\n  \"font_size\": \"medium\",\n  \"favorite_fandoms\": [\"Naruto\", \"Final Fantasy\"],\n  \"category_ids\": [{{category_id}}],\n  \"display_preferences\": {\n    \"default_sort\": \"latest\",\n    \"content_layout\": \"grid\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/profile"
          }
        },
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/dashboard" } },
        { "name": "Activity", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/dashboard/activity" } }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "Categories", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/categories" } },
        { "name": "Tags", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/tags" } },
        { "name": "Explore", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/explore?sort=latest&category_id={{category_id}}&per_page=12" } },
        { "name": "Upcoming", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/upcoming" } },
        { "name": "Content Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/catalog/content/{{content_id}}" } },
        { "name": "Article Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/catalog/article/{{article_id}}" } },
        { "name": "Character Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/catalog/character/{{character_id}}" } },
        { "name": "Media Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/catalog/media/{{media_id}}" } },
        { "name": "Merchandise Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/catalog/merchandise/{{merchandise_id}}" } },
        { "name": "Share", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/share/article/{{article_id}}" } }
      ]
    },
    {
      "name": "Bookmarks and Ratings",
      "item": [
        {
          "name": "Create Bookmark",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"item_type\": \"article\",\n  \"item_id\": {{article_id}},\n  \"note\": \"Read later\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/bookmarks"
          }
        },
        { "name": "Bookmarks", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/bookmarks" } },
        {
          "name": "Rate Media Stars",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating_value\": 5\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/media/{{media_id}}/rating"
          }
        },
        { "name": "My Media Rating", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/media/{{media_id}}/rating" } }
      ]
    },
    {
      "name": "Submissions and Feedback",
      "item": [
        {
          "name": "Create Submission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{category_id}},\n  \"title\": \"My fan article\",\n  \"body_html\": \"<p>This is a fan submission.</p>\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/submissions"
          }
        },
        { "name": "My Submissions", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/submissions" } },
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"suggestion\",\n  \"message\": \"Please add more fandom filters.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/feedback"
          }
        },
        { "name": "My Feedback", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/feedback" } }
      ]
    },
    {
      "name": "Events",
      "item": [
        { "name": "Events", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/events?city=Lahore" } },
        { "name": "Nearby Events", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/events?latitude=31.5204&longitude=74.3587&radius_km=50" } },
        { "name": "Event Detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/events/{{event_id}}" } }
      ]
    }
  ]
}
